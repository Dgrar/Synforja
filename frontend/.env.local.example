# URL pública de la API. Usa el mismo host que el frontend para compartir cookies.
# Canónico en desarrollo: frontend http://localhost:3000 + API http://localhost:8000.
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Si usas 127.0.0.1, cámbialo también aquí:
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api
